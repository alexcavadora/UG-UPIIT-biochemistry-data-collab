RAW_DATA_ROOT=raw_data/Datos Sensor A (Espadas) B. thuringiensis
OUTPUT_CSV_DIR=data_csv
PLOTS_DIR=plots

KINETIC_FILE_PATTERN=*cin*.xlsx
DIELECTRIC_FILE_PATTERN=*diel*.xlsx

SENSOR_COLS_START=0
SENSOR_COLS_END=6
SAMPLE_COLS_START=9
SAMPLE_COLS_END=14

TARGET_COLUMNS=time,glucose,lactate,biomass,spores,co2

MIN_FREQUENCIES=50
EXCLUDE_FREQUENCIES=

TIME_COL_NAMES=tiempo,time,hora
FRACTIONAL_DAY_THRESHOLD=1.0

USE_GLOBAL_STERILE=true
